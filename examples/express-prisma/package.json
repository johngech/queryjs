{
  "name": "@queryjs/example-express-prisma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "QueryJS + Express + Prisma (SQLite) example server",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push && prisma generate",
    "seed": "bun run src/seed.ts",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run prisma:generate && bun run typecheck"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "@queryjs/core": "file:../../packages/core",
    "@queryjs/prisma": "file:../../packages/prisma",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "prisma": "7.10.0",
    "typescript": "^7.0.2"
  }
}
