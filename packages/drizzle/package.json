{
  "name": "@queryjs/drizzle",
  "version": "0.2.1",
  "description": "Drizzle adapter for QueryJS: translates validated ResourceQuery objects into Drizzle SQL where and orderBy fragments plus skip and take.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johngech/queryjs.git",
    "directory": "packages/drizzle"
  },
  "author": "Yohannes Getachew <yohngech@gmail.com>",
  "bugs": {
    "url": "https://github.com/johngech/queryjs/issues"
  },
  "homepage": "https://github.com/johngech/queryjs/tree/main/packages/drizzle#readme",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@queryjs/core": "^0.2.1",
    "drizzle-orm": "^0.38.3 || ^0.45.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-orm": "^0.45.3",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "queryjs",
    "drizzle",
    "orm",
    "adapter",
    "query",
    "query-parser"
  ]
}
