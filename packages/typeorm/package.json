{
  "name": "@queryjs/typeorm",
  "version": "0.2.1",
  "description": "TypeORM adapter for QueryJS: translates validated ResourceQuery objects into TypeORM where, order, skip, and take arguments using real FindOperators.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johngech/queryjs.git",
    "directory": "packages/typeorm"
  },
  "author": "Yohannes Getachew <yohngech@gmail.com>",
  "bugs": {
    "url": "https://github.com/johngech/queryjs/issues"
  },
  "homepage": "https://github.com/johngech/queryjs/tree/main/packages/typeorm#readme",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@queryjs/core": "^0.2.1",
    "typeorm": "^0.3.20 || ^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typeorm": "^1.1.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "queryjs",
    "typeorm",
    "orm",
    "adapter",
    "query",
    "query-parser"
  ]
}
