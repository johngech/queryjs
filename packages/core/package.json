{
  "name": "@queryjs/core",
  "version": "0.2.1",
  "description": "Type-safe, declarative query language for REST APIs: parse filter, sort, search, and pagination HTTP query parameters into validated ResourceQuery objects, then map them to any ORM via pluggable adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johngech/queryjs.git",
    "directory": "packages/core"
  },
  "author": "Yohannes Getachew <yohngech@gmail.com>",
  "bugs": {
    "url": "https://github.com/johngech/queryjs/issues"
  },
  "homepage": "https://github.com/johngech/queryjs/tree/main/packages/core#readme",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./compiler": {
      "import": {
        "types": "./dist/compiler/index.d.ts",
        "default": "./dist/compiler/index.js"
      },
      "require": {
        "types": "./dist/compiler/index.d.ts",
        "default": "./dist/compiler/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.0"
  },
  "keywords": [
    "query",
    "parser",
    "query-parser",
    "filter",
    "sort",
    "search",
    "pagination",
    "queryjs",
    "orm",
    "rest",
    "api"
  ]
}
